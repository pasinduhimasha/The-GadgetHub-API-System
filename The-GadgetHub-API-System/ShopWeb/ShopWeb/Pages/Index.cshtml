
@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}




<!-- 🌟 Hero Section Starts Here -->
<section class="hero">
    <div class="hero-content animate__animated animate__fadeInDown">
        <h1 class="animate__animated animate__fadeInUp">Welcome to The Gadget Hub</h1>
        <p class="animate__animated animate__fadeInUp animate__delay-1s">Explore the latest tech gadgets at unbeatable prices.</p>
        <a class="hero-btn animate__animated animate__fadeInUp animate__delay-2s" asp-page="/Items">Shop Now</a>
    </div>
</section>



<!-- 🔄 Auto-Scrolling Carousel Section -->
@{
    var featuredProducts = new[]
    {
        new { Image = "samsung_s25_ultra.jpg", Title = "Samsung Galaxy S25 Ultra", Description = "Next-gen performance with stunning camera upgrades." },
        new { Image = "iphone_16_pro.jpg", Title = "iPhone 16 Pro", Description = "Faster, smarter, sleeker – Apple’s latest innovation." },
        new { Image = "pixel_watch_2.jpg", Title = "Pixel Watch 2", Description = "Seamless Google integration with fitness tracking." },
        new { Image = "bose_qce2.jpg", Title = "Bose QuietComfort Earbuds II", Description = "Ultimate noise cancellation and rich sound." },
        new { Image = "garmin_fenix_8.jpg", Title = "Garmin Fenix 8", Description = "Rugged GPS smartwatch built for adventure." },
        new { Image = "oneplus_buds_pro_2.jpg", Title = "OnePlus Buds Pro 2", Description = "Flagship earbuds with Dolby Atmos support." }
    };
}
<!-- 🔄 Auto-Scrolling Carousel Section -->
<div class="container my-5">
    <h2 class="text-center mb-4">Featured Products</h2>
    <div class="carousel-track-wrapper">
        <div class="carousel-track-left d-flex flex-wrap justify-content-center">
            @for (int repeat = 0; repeat < 4; repeat++) // Loop for smoother animation
            {
                foreach (var product in featuredProducts)
                {
                    <div class="product-card-carousel card shadow mx-2 my-3 text-center" style="width: 16rem;">
                        <img src="~/images/@product.Image" class="card-img-top" alt="@product.Title">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <h5 class="card-title">@product.Title</h5>
                            <p class="card-text text-muted">@product.Description</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>



<!-- 🔍 Popular Categories Section -->
@{
    var categories = new[]
    {
        new { Image = "smart-rings.jpg", Name = "Smart Rings", Description = "Compact wearable tech for health & security." },
        new { Image = "smart-glasses.jpg", Name = "Smart Glasses", Description = "Augmented reality and hands-free notifications." },
        new { Image = "tablets.jpg", Name = "Tablets", Description = "Portable power for work and entertainment." },
        new { Image = "fitness-trackers.jpg", Name = "Fitness Trackers", Description = "Monitor activity, sleep, and workouts." },
        new { Image = "portable-speakers.jpg", Name = "Portable Speakers", Description = "High-quality sound wherever you go." },
        new { Image = "e-readers.jpg", Name = "E-Readers", Description = "Carry thousands of books in one device." }
    };
}
<div class="container my-5">
    <h2 class="text-center mb-4">Featured Categories</h2>
    <div class="carousel-track-wrapper">
        <div class="carousel-track-right">
            @for (int repeat = 0; repeat < 4; repeat++) // Repeat 4 times for smooth loop
            {
                foreach (var category in categories)
                {
                    <div class="product-card-carousel card shadow animate__animated animate__fadeInUp">
                        <img src="~/images/@category.Image" class="card-img-top" alt="@category.Name" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@category.Name</h5>
                            <p class="card-text">@category.Description</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>



<!-- 🔄why-choose-us-->

<section class="why-choose-us py-5 bg-light">
    <div class="container text-center">
        <h2 class="mb-4">Why Choose The Gadget Hub?</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <i class="bi bi-truck display-4 text-primary"></i>
                <h5 class="mt-3">Fast Shipping</h5>
                <p>Get your gadgets delivered to your doorstep in record time.</p>
            </div>
            <div class="col-md-4 mb-4">
                <i class="bi bi-tags display-4 text-primary"></i>
                <h5 class="mt-3">Best Price Guarantee</h5>
                <p>We compare distributors so you always get the best deal.</p>
            </div>
            <div class="col-md-4 mb-4">
                <i class="bi bi-headset display-4 text-primary"></i>
                <h5 class="mt-3">24/7 Customer Support</h5>
                <p>Our friendly team is here to help you anytime.</p>
            </div>
        </div>
    </div>
</section>



<!-- 🛍️ About The Gadget Hub Section -->
<section class="about-gadget-hub">
    <div class="container">
        <div class="row align-items-center">
            <!-- Text Content -->
            <div class="col-md-6">
                <h2>About The Gadget Hub</h2>
                <p class="lead">
                    The Gadget Hub is your one-stop platform to browse, compare, and purchase the latest tech from verified distributors – all without leaving your home.
                </p>
                <ul>
                    <li><i class="bi bi-bell-fill"></i> Stay updated with instant notifications</li>
                    <li><i class="bi bi-bag-plus-fill"></i> Seamless add-to-cart experience</li>
                    <li><i class="bi bi-cart-check-fill"></i> One-click ordering with secure checkout</li>
                    <li><i class="bi bi-shield-lock-fill"></i> Transparent, fast, and secure shopping</li>
                </ul>
            </div>

            <!-- Image or Illustration -->
            <div class="col-md-6 text-center">
                <img src="/images/about-gadget-hub.gif" alt="About Gadget Hub">
            </div>
        </div>
    </div>
</section>



<!-- 🌟 Customer Testimonials Section -->
<section id="testimonials" class="testimonials py-5 ">
    <div class="container text-center">
        <h2 class="mb-4">What Our Customers Say</h2>
        <div class="testimonial-slider-wrapper position-relative mx-auto" style="max-width: 900px;">
            <button class="slider-btn prev" aria-label="Previous testimonial">&#10094;</button>
            <div class="testimonial-slider">
                <div class="testimonial-slide active">
                    <div class="testimonial-content">
                        <div class="testimonial-image mb-3">
                            <img src="~/images/customer1.jpg" alt="Nimal" />
                        </div>
                        <p>"The Gadget Hub made my gadget shopping a breeze. Great prices and quick delivery!"</p>
                        <strong>Nimal K., Colombo</strong>
                    </div>
                </div>
                <div class="testimonial-slide">
                    <div class="testimonial-content">
                        <div class="testimonial-image mb-3">
                            <img src="~/images/customer2.jpg" alt="Samantha" />
                        </div>
                        <p>"Excellent customer service and product selection. Highly recommend The Gadget Hub."</p>
                        <strong>Samantha W., Kandy</strong>
                    </div>
                </div>
                <div class="testimonial-slide">
                    <div class="testimonial-content">
                        <div class="testimonial-image mb-3">
                            <img src="~/images/customer3.jpg" alt="Raj" />
                        </div>
                        <p>"Fast shipping and best prices. I always check The Gadget Hub first for gadgets."</p>
                        <strong>Raj P., Galle</strong>
                    </div>
                </div>
            </div>
            <button class="slider-btn next" aria-label="Next testimonial">&#10095;</button>
        </div>
    </div>
</section>


